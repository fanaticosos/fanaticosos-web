[Unit]
Description=Fanaticosos bounded article TTS job %i
After=local-fs.target

[Service]
Type=exec
User=fanaticosos-blog
Group=fanaticosos-blog
WorkingDirectory=/opt/fanaticosos-blog/repository
Environment=HOME=/opt/fanaticosos-blog
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
EnvironmentFile=-/etc/fanaticosos-blog/azure-speech.env
EnvironmentFile=-/etc/fanaticosos-blog/elevenlabs.env
ExecStartPre=/usr/bin/test -f /opt/fanaticosos-blog/jobs/%i/request.json
ExecStartPre=/usr/bin/test ! -e /opt/fanaticosos-blog/jobs/%i/audio
ExecStart=/opt/fanaticosos-blog/runtimes/tts-benchmark-kokoro-v1/bin/python /opt/fanaticosos-blog/repository/scripts/tts/render_article_production.py --request /opt/fanaticosos-blog/jobs/%i/request.json --repository /opt/fanaticosos-blog/repository --output /opt/fanaticosos-blog/jobs/%i/audio
RuntimeMaxSec=15min
MemoryMax=8G
MemorySwapMax=1G
KillMode=control-group
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/fanaticosos-blog/jobs/%i
UMask=0077

[Install]
# Static template: instances are started explicitly by the private publisher.
