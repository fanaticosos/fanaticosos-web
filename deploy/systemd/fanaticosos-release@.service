[Unit]
Description=Fanaticosos private release build %i
After=local-fs.target
ConditionPathExists=/opt/fanaticosos-blog/publisher/releases/%i/request.json

[Service]
Type=exec
User=fanaticosos-blog
Group=fanaticosos-blog
WorkingDirectory=/opt/fanaticosos-blog/repository
Environment=HOME=/opt/fanaticosos-blog
Environment=NODE_ENV=production
ExecStart=/opt/nodejs/current/bin/node /opt/fanaticosos-blog/repository/scripts/publisher/build_release.mjs --request /opt/fanaticosos-blog/publisher/releases/%i/request.json --repository /opt/fanaticosos-blog/repository --publisher-root /opt/fanaticosos-blog/publisher --jobs-root /opt/fanaticosos-blog/jobs --output /opt/fanaticosos-blog/publisher/releases/%i/release
RuntimeMaxSec=10min
MemoryMax=4G
MemorySwapMax=512M
KillMode=control-group
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/fanaticosos-blog/publisher/releases/%i
UMask=0077

[Install]
# Static template: the private publisher starts one validated release build.
