[Unit]
Description=Fanaticosos validated production deployment %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/fanaticosos-blog/publisher/releases/%i/production-request.json

[Service]
Type=oneshot
ExecStart=/opt/fanaticosos-blog/repository/scripts/deployment/deploy_cloudflare_production.sh /opt/fanaticosos-blog/repository /opt/fanaticosos-blog %i
ExecStopPost=/opt/nodejs/current/bin/node /opt/fanaticosos-blog/repository/scripts/publisher/record_production_deploy_exit.mjs --release-root /opt/fanaticosos-blog/publisher/releases/%i --service-result ${SERVICE_RESULT} --exit-status ${EXIT_STATUS}
TimeoutStartSec=10min
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/fanaticosos-blog/publisher/releases/%i
