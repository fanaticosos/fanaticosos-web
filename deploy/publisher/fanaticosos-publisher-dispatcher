#!/usr/bin/env bash
set -euo pipefail

readonly queue_root="/opt/fanaticosos-blog/publisher/queue"
readonly jobs_root="/opt/fanaticosos-blog/jobs"
readonly releases_root="/opt/fanaticosos-blog/publisher/releases"
readonly repository="/opt/fanaticosos-blog/repository"
readonly service_account="fanaticosos-blog"

[[ "$(id -u)" == "0" ]] || { echo "Must run as root." >&2; exit 1; }
[[ "$(hostname)" == "papabear" ]] || { echo "Wrong host." >&2; exit 1; }
install -d -o "$service_account" -g "$service_account" -m 0700 "$queue_root" "$jobs_root"
install -d -o "$service_account" -g "$service_account" -m 0700 "$releases_root"

shopt -s nullglob
for queued in "$queue_root"/translation-*-r*-*; do
  [[ -d "$queued" && ! -L "$queued" ]] || continue
  job_id="$(basename "$queued")"
  [[ "$job_id" =~ ^translation-[0-9a-f]{32}-r[1-9][0-9]*-[0-9a-f]{8}$ ]] || continue
  [[ "$(stat -c %U:%G "$queued")" == "$service_account:$service_account" ]] || continue
  [[ -f "$queued/request.json" && ! -L "$queued/request.json" ]] || continue
  [[ ! -e "$jobs_root/$job_id" ]] || continue
  runuser -u "$service_account" -- env PYTHONDONTWRITEBYTECODE=1 python3 - "$repository" "$queued/request.json" <<'PY'
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(sys.argv[1]) / "scripts" / "translation"))
from article_contract import validate_translation_request
with open(sys.argv[2], encoding="utf-8") as handle:
    validate_translation_request(json.load(handle))
PY
  mv "$queued" "$jobs_root/$job_id"
  chown -R "$service_account:$service_account" "$jobs_root/$job_id"
  chmod 0700 "$jobs_root/$job_id"
  chmod 0600 "$jobs_root/$job_id/request.json"
  systemctl reset-failed "fanaticosos-translation@$job_id.service" 2>/dev/null || true
  systemctl start --no-block "fanaticosos-translation@$job_id.service"
done
for queued in "$queue_root"/tts-??-*-r*-*; do
  [[ -d "$queued" && ! -L "$queued" ]] || continue
  job_id="$(basename "$queued")"
  [[ "$job_id" =~ ^tts-(es|en)-[0-9a-f]{32}-r[1-9][0-9]*-[0-9a-f]{8}$ ]] || continue
  [[ "$(stat -c %U:%G "$queued")" == "$service_account:$service_account" ]] || continue
  [[ -f "$queued/request.json" && ! -L "$queued/request.json" ]] || continue
  [[ ! -e "$jobs_root/$job_id" ]] || continue
  runuser -u "$service_account" -- env PYTHONDONTWRITEBYTECODE=1 python3 - "$repository" "$queued/request.json" <<'PY'
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(sys.argv[1]) / "scripts" / "tts"))
from article_contract import validate_request
with open(sys.argv[2], encoding="utf-8") as handle:
    validate_request(json.load(handle))
PY
  mv "$queued" "$jobs_root/$job_id"
  chown -R "$service_account:$service_account" "$jobs_root/$job_id"
  chmod 0700 "$jobs_root/$job_id"
  chmod 0600 "$jobs_root/$job_id/request.json"
  systemctl reset-failed "fanaticosos-tts@$job_id.service" 2>/dev/null || true
  systemctl start --no-block "fanaticosos-tts@$job_id.service"
done
for queued in "$queue_root"/release-*-r*-*; do
  [[ -d "$queued" && ! -L "$queued" ]] || continue
  job_id="$(basename "$queued")"
  [[ "$job_id" =~ ^release-[0-9a-f]{32}-r[1-9][0-9]*-[0-9a-f]{8}$ ]] || continue
  [[ "$(stat -c %U:%G "$queued")" == "$service_account:$service_account" ]] || continue
  [[ -f "$queued/request.json" && ! -L "$queued/request.json" ]] || continue
  [[ ! -e "$releases_root/$job_id" ]] || continue
  release_kind="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("releaseKind", "article"))' "$queued/request.json")"
  if [[ "$release_kind" == "music" ]]; then
    runuser -u "$service_account" -- /opt/nodejs/current/bin/node "$repository/scripts/publisher/build_music_release.mjs" --request "$queued/request.json" --repository "$repository" --releases-root "$releases_root" --output "$releases_root/$job_id/release" --validate-only
  else
    runuser -u "$service_account" -- /opt/nodejs/current/bin/node "$repository/scripts/publisher/build_release.mjs" --request "$queued/request.json" --repository "$repository" --publisher-root /opt/fanaticosos-blog/publisher --jobs-root "$jobs_root" --output "$releases_root/$job_id/release" --validate-only
  fi
  mv "$queued" "$releases_root/$job_id"
  chown -R "$service_account:$service_account" "$releases_root/$job_id"
  chmod 0700 "$releases_root/$job_id"
  chmod 0600 "$releases_root/$job_id/request.json"
  unit="fanaticosos-release@$job_id.service"
  [[ "$release_kind" == "music" ]] && unit="fanaticosos-music-release@$job_id.service"
  systemctl reset-failed "$unit" 2>/dev/null || true
  systemctl start --no-block "$unit"
done
for queued in "$queue_root"/deploy-release-*-r*-*; do
  [[ -d "$queued" && ! -L "$queued" ]] || continue
  deploy_id="$(basename "$queued")"; job_id="${deploy_id#deploy-}"
  [[ "$job_id" =~ ^release-[0-9a-f]{32}-r[1-9][0-9]*-[0-9a-f]{8}$ ]] || continue
  [[ "$(stat -c %U:%G "$queued")" == "$service_account:$service_account" ]] || continue
  [[ -f "$queued/request.json" && ! -L "$queued/request.json" && -f "$releases_root/$job_id/release/release-manifest.json" ]] || continue
  [[ ! -e "$releases_root/$job_id/production-request.json" ]] || continue
  mv "$queued/request.json" "$releases_root/$job_id/production-request.json"; rm -d "$queued"
  chown "$service_account:$service_account" "$releases_root/$job_id/production-request.json"; chmod 0600 "$releases_root/$job_id/production-request.json"
  systemctl reset-failed "fanaticosos-production-deploy@$job_id.service" 2>/dev/null || true
  systemctl start --no-block "fanaticosos-production-deploy@$job_id.service"
done
rm -f -- "$queue_root/.wake"
