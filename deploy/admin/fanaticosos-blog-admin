#!/usr/bin/env bash
set -euo pipefail

readonly service_account="fanaticosos-blog"
readonly project_root="/opt/fanaticosos-blog"
readonly legacy_repository="/srv/fanaticosos-blog/repository"
if [[ -d "$project_root/repository/.git" ]]; then
  readonly repository="$project_root/repository"
  readonly data_root="$project_root"
else
  readonly repository="$legacy_repository"
  readonly data_root="/var/lib/fanaticosos-blog"
fi
readonly branch="feature/multilingual-audio-blog"
readonly source_unit="$repository/deploy/systemd/fanaticosos-translation@.service"
readonly installed_unit="/etc/systemd/system/fanaticosos-translation@.service"
readonly tts_source_unit="$repository/deploy/systemd/fanaticosos-tts@.service"
readonly fixture="$repository/benchmarks/translation/full-article-request.json"
readonly jobs_root="$data_root/jobs"
readonly kokoro_venv="$data_root/runtimes/tts-benchmark-kokoro-v1"
readonly kokoro_requirements="$repository/config/tts/kokoro-benchmark-requirements.txt"
readonly kokoro_manifest="$repository/config/tts/kokoro-candidate-files.json"
readonly kokoro_model="$data_root/models/kokoro-82m/f3ff3571791e39611d31c381e3a41a3af07b4987"
readonly kokoro_benchmark="$repository/benchmarks/tts/es-en.json"
readonly kokoro_runner="$repository/scripts/tts/benchmark_kokoro.py"
readonly kokoro_output="$data_root/work/tts-benchmark-kokoro-v2"
readonly kokoro_pronunciations="$repository/config/tts/pronunciations.json"
readonly spacy_model_manifest="$repository/config/tts/spacy-english-model.json"
readonly spanglish_diagnostic="$data_root/work/tts-spanglish-diagnostic-v1"
readonly tts_tuning_output="$data_root/work/tts-selected-voice-tuning-v1"
readonly latino_diagnostic="$data_root/work/tts-latino-diagnostic-v3"
readonly long_form_review="$data_root/work/tts-long-form-review-v2"

usage() {
  cat <<'EOF'
Usage: sudo -n /usr/local/sbin/fanaticosos-blog-admin COMMAND [ARGS]

Commands:
  sync EXPECTED_COMMIT
  preflight EXPECTED_COMMIT JOB_ID
  install-translation-template EXPECTED_COMMIT
  prepare-acceptance-job EXPECTED_COMMIT JOB_ID
  start-translation JOB_ID
  translation-status JOB_ID
  translation-result JOB_ID
  translation-failure JOB_ID
  host-health
  update-admin EXPECTED_COMMIT
  install-kokoro-runtime EXPECTED_COMMIT
  kokoro-runtime-status
  download-kokoro-candidates EXPECTED_COMMIT
  migrate-to-opt EXPECTED_COMMIT
  release-layout-status
  finalize-opt-layout EXPECTED_COMMIT
  run-kokoro-benchmark EXPECTED_COMMIT
  kokoro-benchmark-status
  install-kokoro-english-model EXPECTED_COMMIT
  export-kokoro-samples EXPECTED_COMMIT
  verify-tts-template EXPECTED_COMMIT
  run-spanglish-diagnostic EXPECTED_COMMIT
  export-spanglish-diagnostic EXPECTED_COMMIT
  run-tts-tuning-matrix EXPECTED_COMMIT
  export-tts-tuning-matrix EXPECTED_COMMIT
  run-latino-diagnostic EXPECTED_COMMIT
  export-latino-diagnostic EXPECTED_COMMIT
  run-tts-long-form-review EXPECTED_COMMIT
  export-tts-long-form-review EXPECTED_COMMIT
EOF
}

stop() {
  echo "STOP: $*" >&2
  exit 1
}

require_root() {
  [[ "$(id -u)" == "0" ]] || stop "This helper must run through sudo."
  [[ "$(hostname)" == "papabear" ]] || stop "Wrong server. Expected papabear."
}

validate_commit() {
  [[ "${1:-}" =~ ^[0-9a-f]{7,40}$ ]] || stop "Invalid expected commit."
}

validate_job_id() {
  [[ "${1:-}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || stop "Invalid job ID."
}

run_as_service() {
  runuser -u "$service_account" -- "$@"
}

repository_commit() {
  run_as_service git -C "$repository" rev-parse HEAD
}

require_repository_commit() {
  local expected="$1"
  local actual
  validate_commit "$expected"
  actual="$(repository_commit)"
  [[ "$actual" == "$expected"* ]] || stop "Expected commit $expected; found ${actual:0:7}."
  [[ -z "$(run_as_service git -C "$repository" status --porcelain)" ]] || \
    stop "Repository is not clean."
}

job_unit() {
  printf 'fanaticosos-translation@%s.service' "$1"
}

command_sync() {
  local expected="$1"
  local fetched
  validate_commit "$expected"
  [[ -z "$(run_as_service git -C "$repository" status --porcelain)" ]] || \
    stop "Repository is not clean."
  run_as_service git -C "$repository" fetch origin "$branch"
  fetched="$(run_as_service git -C "$repository" rev-parse FETCH_HEAD)"
  [[ "$fetched" == "$expected"* ]] || stop "Fetched commit does not match $expected."
  run_as_service git -C "$repository" merge --ff-only FETCH_HEAD
  require_repository_commit "$expected"
  echo "PASS: Repository synchronized to ${fetched:0:7}."
}

command_preflight() {
  local expected="$1"
  local job_id="$2"
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  exec "$repository/scripts/deployment/preflight_translation_acceptance.sh" \
    --expected-commit "$expected" \
    --job-id "$job_id"
}

command_install_translation_template() {
  local expected="$1"
  local diagnostics
  require_repository_commit "$expected"
  diagnostics="$(systemd-analyze verify "$source_unit" 2>&1)"
  [[ -z "$diagnostics" ]] || stop "Versioned unit produced diagnostics: $diagnostics"
  install -o root -g root -m 0644 "$source_unit" "$installed_unit"
  systemctl daemon-reload
  cmp -s "$source_unit" "$installed_unit" || stop "Installed unit differs from Git."
  diagnostics="$(systemd-analyze verify "$installed_unit" 2>&1)"
  [[ -z "$diagnostics" ]] || stop "Installed unit produced diagnostics: $diagnostics"
  echo "PASS: Translation template installed from commit $expected."
}

command_prepare_acceptance_job() {
  local expected="$1"
  local job_id="$2"
  local job_dir
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  [[ ! -e "$job_dir" ]] || stop "Job already exists: $job_id"
  install -d -o "$service_account" -g "$service_account" -m 0700 "$job_dir"
  install -o "$service_account" -g "$service_account" -m 0600 \
    "$fixture" "$job_dir/request.json"
  echo "PASS: Acceptance job prepared: $job_id"
}

command_start_translation() {
  local job_id="$1"
  local job_dir
  local unit
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  unit="$(job_unit "$job_id")"
  [[ -f "$job_dir/request.json" ]] || stop "Request is missing for $job_id."
  [[ ! -e "$job_dir/result.json" ]] || stop "Result already exists for $job_id."
  [[ ! -e "$job_dir/failed-output.json" ]] || stop "Failure output already exists for $job_id."
  systemctl reset-failed "$unit" 2>/dev/null || true
  systemctl start --wait "$unit"
  [[ "$(systemctl show "$unit" --property=Result --value)" == "success" ]] || \
    stop "Translation unit did not report success."
  echo "PASS: Translation job completed: $job_id"
}

command_translation_status() {
  local job_id="$1"
  local job_dir
  local unit
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  unit="$(job_unit "$job_id")"
  systemctl show "$unit" \
    --property=LoadState \
    --property=ActiveState \
    --property=SubState \
    --property=Result \
    --property=ExecMainCode \
    --property=ExecMainStatus \
    --property=RuntimeMaxUSec \
    --property=MemoryMax \
    --property=MemorySwapMax \
    --property=KillMode \
    --no-pager
  if [[ -d "$job_dir" ]]; then
    find "$job_dir" -maxdepth 1 -type f \
      -printf '%m %u:%g %s bytes %f\n' | sort
  fi
}

command_translation_result() {
  local job_id="$1"
  local result
  validate_job_id "$job_id"
  result="$jobs_root/$job_id/result.json"
  [[ -f "$result" ]] || stop "Result is missing for $job_id."
  run_as_service cat "$result"
}

command_translation_failure() {
  local job_id="$1"
  local failure
  validate_job_id "$job_id"
  failure="$jobs_root/$job_id/failed-output.json"
  [[ -f "$failure" ]] || stop "Failure output is missing for $job_id."
  run_as_service env PYTHONDONTWRITEBYTECODE=1 python3 - "$failure" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    failure = json.load(handle)

print(f"Error type: {failure['errorType']}")
print(f"Error: {failure['error']}")
print("Final 4000 characters:")
print(failure["lastRawOutput"][-4000:])
PY
}

command_host_health() {
  free -h
  swapon --show
  df -h /
  systemctl is-active ssh
  systemctl is-active netbird
  pgrep -af 'translate_article_qwen.py|llama-cli|Qwen3-8B-Q4_K_M' || true
}

command_update_admin() {
  local expected="$1"
  local helper_source="$repository/deploy/admin/fanaticosos-blog-admin"
  local sudoers_source="$repository/deploy/admin/fanaticosos-blog-admin.sudoers"
  require_repository_commit "$expected"
  bash -n "$helper_source"
  visudo -cf "$sudoers_source" >/dev/null
  install -o root -g root -m 0755 "$helper_source" \
    /usr/local/sbin/fanaticosos-blog-admin
  install -o root -g root -m 0440 "$sudoers_source" \
    /etc/sudoers.d/fanaticosos-blog-admin
  visudo -cf /etc/sudoers.d/fanaticosos-blog-admin >/dev/null
  echo "PASS: Restricted administration helper updated from commit $expected."
}

command_install_kokoro_runtime() {
  local expected="$1"
  require_repository_commit "$expected"
  [[ -f "$kokoro_requirements" ]] || stop "Pinned Kokoro requirements are missing."
  [[ ! -e "$kokoro_venv" ]] || stop "Kokoro benchmark runtime already exists."

  cleanup_incomplete_kokoro_runtime() {
    rm -rf -- "$kokoro_venv"
  }
  trap cleanup_incomplete_kokoro_runtime EXIT

  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends espeak-ng

  run_as_service python3 -m venv "$kokoro_venv"
  run_as_service "$kokoro_venv/bin/python" -m pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    --requirement "$kokoro_requirements"
  run_as_service env PYTHONDONTWRITEBYTECODE=1 \
    "$kokoro_venv/bin/python" -c \
    'import importlib.metadata as m; import kokoro, soundfile, torch; print("kokoro={} soundfile={} torch={}".format(m.version("kokoro"), m.version("soundfile"), torch.__version__))'
  trap - EXIT
  run_as_service "$kokoro_venv/bin/python" -m pip freeze \
    > "$data_root/work/kokoro-benchmark-runtime.freeze"
  chown "$service_account:$service_account" \
    "$data_root/work/kokoro-benchmark-runtime.freeze"
  chmod 0600 "$data_root/work/kokoro-benchmark-runtime.freeze"

  echo "PASS: Isolated Kokoro benchmark runtime installed."
  echo "PASS: No model, voice, service, listener, or audio was created."
}

command_kokoro_runtime_status() {
  dpkg-query -W -f='${binary:Package} ${Version} ${db:Status-Abbrev}\n' \
    espeak-ng libsndfile1 2>/dev/null || true
  if [[ -d "$kokoro_venv" ]]; then
    stat -c 'owner=%U group=%G mode=%a size=%s path=%n' "$kokoro_venv"
    run_as_service "$kokoro_venv/bin/python" -c \
      'import importlib.metadata as m; import spacy, torch; print("kokoro={} misaki={} spacy={} soundfile={} torch={} cuda={} spacy_models={}".format(m.version("kokoro"), m.version("misaki"), m.version("spacy"), m.version("soundfile"), torch.__version__, torch.cuda.is_available(), list(spacy.util.get_installed_models())))'
  else
    echo "Kokoro runtime: ABSENT"
  fi
  if [[ -f "$data_root/work/kokoro-benchmark-runtime.freeze" ]]; then
    stat -c 'owner=%U group=%G mode=%a size=%s path=%n' \
      "$data_root/work/kokoro-benchmark-runtime.freeze"
  else
    echo "Runtime manifest: ABSENT"
  fi
  pgrep -af 'pip|kokoro|KPipeline' || true
  df -h /
}

command_download_kokoro_candidates() {
  local expected="$1"
  require_repository_commit "$expected"
  [[ -d "$kokoro_venv" ]] || stop "Verified Kokoro runtime is missing."
  [[ -f "$kokoro_manifest" ]] || stop "Pinned Kokoro file manifest is missing."
  [[ ! -e "$kokoro_model" ]] || stop "Kokoro candidate target already exists."
  run_as_service env PYTHONDONTWRITEBYTECODE=1 \
    "$kokoro_venv/bin/python" \
    "$repository/scripts/tts/download_kokoro_candidates.py" \
    --manifest "$kokoro_manifest" \
    --target "$kokoro_model"
  echo "PASS: No service, listener, or audio was created."
}

command_migrate_to_opt() {
  local expected="$1"
  require_repository_commit "$expected"
  [[ "$repository" == "$legacy_repository" ]] || stop "Repository is already under /opt."
  [[ ! -e "$project_root" ]] || stop "Target already exists: $project_root"
  ! pgrep -f 'translate_article_qwen.py|llama-cli|KPipeline' >/dev/null || \
    stop "A project model process is running."

  install -d -o "$service_account" -g "$service_account" -m 0750 "$project_root"
  mv "$legacy_repository" "$project_root/repository"
  shopt -s dotglob nullglob
  for source in /var/lib/fanaticosos-blog/*; do
    name="$(basename "$source")"
    target_name="$name"
    [[ "$name" != "venvs" ]] || target_name="runtimes"
    [[ ! -e "$project_root/$target_name" ]] || \
      stop "Migration target already exists: $project_root/$target_name"
    mv "$source" "$project_root/$target_name"
  done
  shopt -u dotglob nullglob
  if [[ -e /var/cache/fanaticosos-blog ]]; then
    mv /var/cache/fanaticosos-blog "$project_root/cache"
  fi
  usermod --home "$project_root" "$service_account"
  install -o root -g root -m 0755 \
    "$project_root/repository/deploy/admin/fanaticosos-blog-admin" \
    /usr/local/sbin/fanaticosos-blog-admin
  install -o root -g root -m 0644 \
    "$project_root/repository/deploy/systemd/fanaticosos-translation@.service" \
    "$installed_unit"
  systemctl daemon-reload
  rmdir /srv/fanaticosos-blog /var/lib/fanaticosos-blog 2>/dev/null || true
  echo "PASS: Fanaticosos Blog migrated to $project_root."
}

command_release_layout_status() {
  local release_root
  local file_count
  local total_bytes

  for release_root in \
    /srv/fanaticosos-blog/releases \
    /opt/fanaticosos-blog/releases; do
    echo "=== $release_root ==="
    if [[ ! -e "$release_root" ]]; then
      echo "ABSENT"
      continue
    fi
    [[ -d "$release_root" ]] || stop "Release path is not a directory: $release_root"
    stat -c 'owner=%U group=%G mode=%a path=%n' "$release_root"
    file_count="$(find "$release_root" -xdev -type f -printf '.' | wc -c)"
    total_bytes="$(find "$release_root" -xdev -type f -printf '%s\n' | awk '{ total += $1 } END { print total + 0 }')"
    echo "files=$file_count bytes=$total_bytes"
    while IFS= read -r -d '' file; do
      relative_path="${file#"$release_root"/}"
      printf '%s  %s\n' "$(sha256sum "$file" | cut -d' ' -f1)" "$relative_path"
    done < <(find "$release_root" -xdev -type f -print0 | sort -z)
  done
}

command_finalize_opt_layout() {
  local expected="$1"
  local legacy_root="/srv/fanaticosos-blog"
  local legacy_releases="$legacy_root/releases"
  local target_releases="$project_root/releases"

  require_repository_commit "$expected"
  [[ -d "$legacy_releases" ]] || stop "Legacy release directory is missing."
  [[ -z "$(find "$legacy_releases" -mindepth 1 -print -quit)" ]] || \
    stop "Legacy release directory is not empty."
  [[ ! -e "$target_releases" ]] || stop "Target already exists: $target_releases"
  [[ ! -e /var/lib/fanaticosos-blog ]] || stop "Legacy data root still exists."
  [[ ! -e /var/cache/fanaticosos-blog ]] || stop "Legacy cache root still exists."

  mv "$legacy_releases" "$target_releases"
  chown "$service_account:$service_account" "$target_releases"
  chmod 0750 "$target_releases"
  rmdir "$legacy_root"

  [[ -d "$target_releases" ]] || stop "Target release directory was not created."
  [[ ! -e "$legacy_root" ]] || stop "Legacy project root still exists."
  echo "PASS: Empty release directory moved to $target_releases."
  echo "PASS: Legacy project roots are absent."
}

command_run_kokoro_benchmark() {
  local expected="$1"
  local unit="fanaticosos-kokoro-benchmark.service"

  require_repository_commit "$expected"
  [[ -x "$kokoro_venv/bin/python" ]] || stop "Kokoro runtime is missing."
  [[ -f "$kokoro_runner" ]] || stop "Kokoro benchmark runner is missing."
  [[ -f "$kokoro_benchmark" ]] || stop "Kokoro benchmark fixture is missing."
  [[ -f "$kokoro_manifest" ]] || stop "Kokoro candidate manifest is missing."
  [[ -d "$kokoro_model" ]] || stop "Kokoro candidate model is missing."
  [[ ! -e "$kokoro_output" ]] || stop "Kokoro benchmark output already exists."
  [[ ! -e "$kokoro_output.generating" ]] || stop "Kokoro staging output already exists."
  ! pgrep -f 'benchmark_kokoro.py|KPipeline' >/dev/null || \
    stop "A Kokoro process is already running."

  systemd-run \
    --quiet \
    --wait \
    --collect \
    --service-type=exec \
    --unit="$unit" \
    --property="User=$service_account" \
    --property="Group=$service_account" \
    --property="WorkingDirectory=$repository" \
    --property="Environment=HOME=$data_root" \
    --property="Environment=PYTHONDONTWRITEBYTECODE=1" \
    --property="Environment=HF_HUB_OFFLINE=1" \
    --property="Environment=HF_HUB_DISABLE_TELEMETRY=1" \
    --property="RuntimeMaxSec=15min" \
    --property="MemoryMax=8G" \
    --property="MemorySwapMax=1G" \
    --property="KillMode=control-group" \
    --property="NoNewPrivileges=yes" \
    --property="PrivateTmp=yes" \
    --property="PrivateNetwork=yes" \
    --property="ProtectSystem=strict" \
    --property="ReadWritePaths=$data_root/work" \
    "$kokoro_venv/bin/python" "$kokoro_runner" \
      --benchmark "$kokoro_benchmark" \
      --manifest "$kokoro_manifest" \
      --model-root "$kokoro_model" \
      --pronunciations "$kokoro_pronunciations" \
      --output "$kokoro_output"

  [[ -f "$kokoro_output/metrics.json" ]] || stop "Kokoro metrics are missing."
  [[ "$(find "$kokoro_output" -maxdepth 1 -type f -name '*.mp3' | wc -l)" == "5" ]] || \
    stop "Kokoro benchmark did not produce five MP3 files."
  echo "PASS: Bounded Kokoro listening benchmark completed."
}

command_kokoro_benchmark_status() {
  if [[ ! -d "$kokoro_output" ]]; then
    echo "Kokoro benchmark output: ABSENT"
  else
    stat -c 'owner=%U group=%G mode=%a path=%n' "$kokoro_output"
    find "$kokoro_output" -maxdepth 1 -type f \
      -printf '%m %u:%g %s bytes %f\n' | sort
    run_as_service cat "$kokoro_output/metrics.json"
  fi
  pgrep -af 'benchmark_kokoro.py|KPipeline' || true
  free -h
  swapon --show
}

command_install_kokoro_english_model() {
  local expected="$1"
  local staging_dir="$data_root/work/spacy-model-installing"
  local wheel="$staging_dir/en_core_web_sm-3.8.0-py3-none-any.whl"
  local legacy_wheel="$data_root/work/en_core_web_sm-3.8.0.installing.whl"
  local source
  local expected_size
  local expected_sha256
  local actual_size
  local actual_sha256

  require_repository_commit "$expected"
  [[ -x "$kokoro_venv/bin/python" ]] || stop "Kokoro runtime is missing."
  [[ -f "$spacy_model_manifest" ]] || stop "spaCy model manifest is missing."
  run_as_service "$kokoro_venv/bin/python" -c \
    'import spacy, sys; sys.exit(0 if "en_core_web_sm" not in spacy.util.get_installed_models() else 1)' || \
    stop "spaCy English model is already installed."
  [[ ! -e "$staging_dir" ]] || stop "spaCy model staging directory already exists."

  source="$(jq -er '.source' "$spacy_model_manifest")"
  expected_size="$(jq -er '.size' "$spacy_model_manifest")"
  expected_sha256="$(jq -er '.sha256' "$spacy_model_manifest")"
  [[ "$source" == "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl" ]] || \
    stop "Unexpected spaCy model source."
  [[ "$expected_size" == "12806118" ]] || stop "Unexpected spaCy model size."
  [[ "$expected_sha256" == "1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85" ]] || \
    stop "Unexpected spaCy model checksum."

  cleanup_spacy_install() {
    rm -f -- \
      "$data_root/work/spacy-model-installing/en_core_web_sm-3.8.0-py3-none-any.whl" \
      "$data_root/work/en_core_web_sm-3.8.0.installing.whl"
    rmdir "$data_root/work/spacy-model-installing" 2>/dev/null || true
  }
  trap cleanup_spacy_install EXIT
  install -d -o "$service_account" -g "$service_account" -m 0700 "$staging_dir"
  if [[ -f "$legacy_wheel" ]]; then
    [[ "$(stat -c %U:%G "$legacy_wheel")" == "$service_account:$service_account" ]] || \
      stop "Legacy spaCy staging file has unexpected ownership."
    [[ "$(stat -c %s "$legacy_wheel")" == "$expected_size" ]] || \
      stop "Legacy spaCy staging file has unexpected size."
    [[ "$(sha256sum "$legacy_wheel" | cut -d' ' -f1)" == "$expected_sha256" ]] || \
      stop "Legacy spaCy staging file has unexpected checksum."
    mv "$legacy_wheel" "$wheel"
  else
    run_as_service curl --fail --location --silent --show-error \
      "$source" --output "$wheel"
  fi
  actual_size="$(stat -c %s "$wheel")"
  actual_sha256="$(sha256sum "$wheel" | cut -d' ' -f1)"
  [[ "$actual_size" == "$expected_size" ]] || stop "spaCy model size mismatch."
  [[ "$actual_sha256" == "$expected_sha256" ]] || stop "spaCy model checksum mismatch."
  run_as_service "$kokoro_venv/bin/python" -m pip install \
    --disable-pip-version-check --no-deps "$wheel"
  run_as_service "$kokoro_venv/bin/python" -c \
    'import spacy; assert "en_core_web_sm" in spacy.util.get_installed_models(); spacy.load("en_core_web_sm")'
  cleanup_spacy_install
  trap - EXIT
  run_as_service "$kokoro_venv/bin/python" -m pip freeze \
    > "$data_root/work/kokoro-benchmark-runtime.freeze"
  chown "$service_account:$service_account" \
    "$data_root/work/kokoro-benchmark-runtime.freeze"
  chmod 0600 "$data_root/work/kokoro-benchmark-runtime.freeze"
  echo "PASS: Verified spaCy English model installed for offline Kokoro use."
}

command_export_kokoro_samples() {
  local expected="$1"
  local export_root="/home/sysadmin/fanaticosos-tts-samples-v2"
  local sample

  require_repository_commit "$expected"
  [[ -f "$kokoro_output/metrics.json" ]] || stop "Kokoro metrics are missing."
  [[ ! -e "$export_root" ]] || stop "Review export already exists."
  for sample in \
    es-ef_dora.mp3 \
    es-em_alex.mp3 \
    es-em_santa.mp3 \
    en-af_heart.mp3 \
    en-af_bella.mp3; do
    [[ -f "$kokoro_output/$sample" ]] || stop "Kokoro sample is missing: $sample"
  done

  install -d -o sysadmin -g sysadmin -m 0750 "$export_root"
  for sample in \
    es-ef_dora.mp3 \
    es-em_alex.mp3 \
    es-em_santa.mp3 \
    en-af_heart.mp3 \
