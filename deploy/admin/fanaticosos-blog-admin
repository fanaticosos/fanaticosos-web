import json
import os
import sys

release_dir, manifest_path = sys.argv[1:]
with open(manifest_path, encoding="utf-8") as handle:
    manifest = json.load(handle)
if manifest.get("schemaVersion") != 1 or manifest.get("deployment") != "disabled":
    raise SystemExit("latest private release manifest is invalid")
print(f"Release job: {os.path.basename(release_dir)}")
print(f"Commit: {manifest.get('commit', '')}")
print(f"Deployment: {manifest.get('deployment', '')}")
print(f"Spanish route: {manifest.get('routes', {}).get('es', '')}")
