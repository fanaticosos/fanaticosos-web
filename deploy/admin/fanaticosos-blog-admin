command_install_kokoro_english_model() {
  local expected="$1"
  local staging_dir="$data_root/work/spacy-model-installing"
  local wheel="$staging_dir/en_core_web_sm-3.8.0-py3-none-any.whl"
  local legacy_wheel="$data_root/work/en_core_web_sm-3.8.0.installing.whl"
  local source
  local expected_size
  local expected_sha256
  local actual_size
  local actual_sha256

  require_repository_commit "$expected"
  [[ -x "$kokoro_venv/bin/python" ]] || stop "Kokoro runtime is missing."
  [[ -f "$spacy_model_manifest" ]] || stop "spaCy model manifest is missing."
  run_as_service "$kokoro_venv/bin/python" -c \
    'import spacy, sys; sys.exit(0 if "en_core_web_sm" not in spacy.util.get_installed_models() else 1)' || \
    stop "spaCy English model is already installed."
  [[ ! -e "$staging_dir" ]] || stop "spaCy model staging directory already exists."

  source="$(jq -er '.source' "$spacy_model_manifest")"
  expected_size="$(jq -er '.size' "$spacy_model_manifest")"
  expected_sha256="$(jq -er '.sha256' "$spacy_model_manifest")"
  [[ "$source" == "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl" ]] || \
    stop "Unexpected spaCy model source."
  [[ "$expected_size" == "12806118" ]] || stop "Unexpected spaCy model size."
  [[ "$expected_sha256" == "1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85" ]] || \
    stop "Unexpected spaCy model checksum."

  cleanup_spacy_install() {
    rm -f -- \
      "$data_root/work/spacy-model-installing/en_core_web_sm-3.8.0-py3-none-any.whl" \
      "$data_root/work/en_core_web_sm-3.8.0.installing.whl"
    rmdir "$data_root/work/spacy-model-installing" 2>/dev/null || true
  }
  trap cleanup_spacy_install EXIT
  install -d -o "$service_account" -g "$service_account" -m 0700 "$staging_dir"
  if [[ -f "$legacy_wheel" ]]; then
    [[ "$(stat -c %U:%G "$legacy_wheel")" == "$service_account:$service_account" ]] || \
      stop "Legacy spaCy staging file has unexpected ownership."
    [[ "$(stat -c %s "$legacy_wheel")" == "$expected_size" ]] || \
      stop "Legacy spaCy staging file has unexpected size."
    [[ "$(sha256sum "$legacy_wheel" | cut -d' ' -f1)" == "$expected_sha256" ]] || \
      stop "Legacy spaCy staging file has unexpected checksum."
    mv "$legacy_wheel" "$wheel"
  else
    run_as_service curl --fail --location --silent --show-error \
      "$source" --output "$wheel"
  fi
  actual_size="$(stat -c %s "$wheel")"
  actual_sha256="$(sha256sum "$wheel" | cut -d' ' -f1)"
  [[ "$actual_size" == "$expected_size" ]] || stop "spaCy model size mismatch."
  [[ "$actual_sha256" == "$expected_sha256" ]] || stop "spaCy model checksum mismatch."
  run_as_service "$kokoro_venv/bin/python" -m pip install \
    --disable-pip-version-check --no-deps "$wheel"
  run_as_service "$kokoro_venv/bin/python" -c \
    'import spacy; assert "en_core_web_sm" in spacy.util.get_installed_models(); spacy.load("en_core_web_sm")'
  cleanup_spacy_install
  trap - EXIT
  run_as_service "$kokoro_venv/bin/python" -m pip freeze \
    > "$data_root/work/kokoro-benchmark-runtime.freeze"
  chown "$service_account:$service_account" \
    "$data_root/work/kokoro-benchmark-runtime.freeze"
  chmod 0600 "$data_root/work/kokoro-benchmark-runtime.freeze"
  echo "PASS: Verified spaCy English model installed for offline Kokoro use."
}

