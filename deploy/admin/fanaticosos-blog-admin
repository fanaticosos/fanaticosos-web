stop() {
  echo "STOP: $*" >&2
  exit 1
}

require_root() {
  [[ "$(id -u)" == "0" ]] || stop "This helper must run through sudo."
  [[ "$(hostname)" == "papabear" ]] || stop "Wrong server. Expected papabear."
}

validate_commit() {
  [[ "${1:-}" =~ ^[0-9a-f]{7,40}$ ]] || stop "Invalid expected commit."
}

validate_job_id() {
  [[ "${1:-}" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || stop "Invalid job ID."
}

run_as_service() {
  runuser -u "$service_account" -- "$@"
}

repository_commit() {
  run_as_service git -C "$repository" rev-parse HEAD
}

require_repository_commit() {
  local expected="$1"
  local actual
  validate_commit "$expected"
  actual="$(repository_commit)"
  [[ "$actual" == "$expected"* ]] || stop "Expected commit $expected; found ${actual:0:7}."
  [[ -z "$(run_as_service git -C "$repository" status --porcelain)" ]] || \
    stop "Repository is not clean."
}

job_unit() {
  printf 'fanaticosos-translation@%s.service' "$1"
}

tts_job_unit() {
  printf 'fanaticosos-tts@%s.service' "$1"
}

command_sync() {
  local expected="$1"
  local fetched
  validate_commit "$expected"
  [[ -z "$(run_as_service git -C "$repository" status --porcelain)" ]] || \
    stop "Repository is not clean."
  run_as_service git -C "$repository" fetch origin "$branch"
  fetched="$(run_as_service git -C "$repository" rev-parse FETCH_HEAD)"
  [[ "$fetched" == "$expected"* ]] || stop "Fetched commit does not match $expected."
  run_as_service git -C "$repository" merge --ff-only FETCH_HEAD
  require_repository_commit "$expected"
  echo "PASS: Repository synchronized to ${fetched:0:7}."
}

command_preflight() {
  local expected="$1"
  local job_id="$2"
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  exec "$repository/scripts/deployment/preflight_translation_acceptance.sh" \
    --expected-commit "$expected" \
    --job-id "$job_id"
}

command_install_translation_template() {
  local expected="$1"
  local diagnostics
  require_repository_commit "$expected"
  diagnostics="$(systemd-analyze verify "$source_unit" 2>&1)"
  [[ -z "$diagnostics" ]] || stop "Versioned unit produced diagnostics: $diagnostics"
  install -o root -g root -m 0644 "$source_unit" "$installed_unit"
  systemctl daemon-reload
  cmp -s "$source_unit" "$installed_unit" || stop "Installed unit differs from Git."
  diagnostics="$(systemd-analyze verify "$installed_unit" 2>&1)"
  [[ -z "$diagnostics" ]] || stop "Installed unit produced diagnostics: $diagnostics"
  echo "PASS: Translation template installed from commit $expected."
}

command_import_job_request() {
  local expected="$1"
  local job_id="$2"
  local kind="$3"
  local expected_sha256="$4"
  local import_file
  local job_dir
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  [[ "$kind" == "translation" || "$kind" == "tts" ]] || \
    stop "Import kind must be translation or tts."
  [[ "$expected_sha256" =~ ^[0-9a-f]{64}$ ]] || stop "Invalid request SHA-256."
  import_file="/home/sysadmin/fanaticosos-job-$job_id.json"
  job_dir="$jobs_root/$job_id"
  [[ -f "$import_file" && ! -L "$import_file" ]] || \
    stop "Import file is missing or is not a regular file: $import_file"
  [[ "$(stat -c %U "$import_file")" == "sysadmin" ]] || \
    stop "Import file must be owned by sysadmin."
  [[ "$(sha256sum "$import_file" | awk '{print $1}')" == "$expected_sha256" ]] || \
    stop "Import file checksum does not match."
  [[ ! -e "$job_dir" ]] || stop "Job already exists: $job_id"

  install -d -o "$service_account" -g "$service_account" -m 0700 "$job_dir"
  install -o "$service_account" -g "$service_account" -m 0600 \
    "$import_file" "$job_dir/request.json.importing"
  cleanup_failed_import() {
    rm -rf -- "$job_dir"
  }
  trap cleanup_failed_import ERR
  run_as_service env PYTHONDONTWRITEBYTECODE=1 python3 - \
    "$repository" "$kind" "$job_dir/request.json.importing" <<'PY'
import json
import sys
from pathlib import Path

repository, kind, source = sys.argv[1:]
if kind == "translation":
    sys.path.insert(0, str(Path(repository) / "scripts" / "translation"))
    from article_contract import validate_translation_request
    validator = validate_translation_request
else:
    sys.path.insert(0, str(Path(repository) / "scripts" / "tts"))
    from article_contract import validate_request
    validator = validate_request

with open(source, encoding="utf-8") as handle:
    validator(json.load(handle))
PY

  mv "$job_dir/request.json.importing" "$job_dir/request.json"
  trap - ERR
  rm -f -- "$import_file"
  echo "PASS: Validated $kind request imported: $job_id"
}

command_prepare_acceptance_job() {
  local expected="$1"
  local job_id="$2"
  local job_dir
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  [[ ! -e "$job_dir" ]] || stop "Job already exists: $job_id"
  install -d -o "$service_account" -g "$service_account" -m 0700 "$job_dir"
  install -o "$service_account" -g "$service_account" -m 0600 \
    "$fixture" "$job_dir/request.json"
  echo "PASS: Acceptance job prepared: $job_id"
}

command_start_translation() {
  local job_id="$1"
  local job_dir
  local unit
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  unit="$(job_unit "$job_id")"
  [[ -f "$job_dir/request.json" ]] || stop "Request is missing for $job_id."
  [[ ! -e "$job_dir/result.json" ]] || stop "Result already exists for $job_id."
  [[ ! -e "$job_dir/failed-output.json" ]] || stop "Failure output already exists for $job_id."
  systemctl reset-failed "$unit" 2>/dev/null || true
  systemctl start --wait "$unit"
  [[ "$(systemctl show "$unit" --property=Result --value)" == "success" ]] || \
    stop "Translation unit did not report success."
  echo "PASS: Translation job completed: $job_id"
}

command_translation_status() {
  local job_id="$1"
  local job_dir
  local unit
  validate_job_id "$job_id"
  job_dir="$jobs_root/$job_id"
  unit="$(job_unit "$job_id")"
  systemctl show "$unit" \
    --property=LoadState \
    --property=ActiveState \
    --property=SubState \
    --property=Result \
    --property=ExecMainCode \
    --property=ExecMainStatus \
    --property=RuntimeMaxUSec \
    --property=MemoryMax \
    --property=MemorySwapMax \
    --property=KillMode \
    --no-pager
  if [[ -d "$job_dir" ]]; then
    find "$job_dir" -maxdepth 1 -type f \
      -printf '%m %u:%g %s bytes %f\n' | sort
  fi
}

command_translation_result() {
  local job_id="$1"
  local result
  validate_job_id "$job_id"
  result="$jobs_root/$job_id/result.json"
  [[ -f "$result" ]] || stop "Result is missing for $job_id."
  run_as_service cat "$result"
}

command_translation_failure() {
  local job_id="$1"
  local failure
  validate_job_id "$job_id"
  failure="$jobs_root/$job_id/failed-output.json"
  [[ -f "$failure" ]] || stop "Failure output is missing for $job_id."
  run_as_service env PYTHONDONTWRITEBYTECODE=1 python3 - "$failure" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    failure = json.load(handle)

print(f"Error type: {failure['errorType']}")
print(f"Error: {failure['error']}")
print("Final 4000 characters:")
print(failure["lastRawOutput"][-4000:])
PY
}

command_export_translation_failure() {
  local job_id="$1"
  local failure
  local destination
  validate_job_id "$job_id"
  failure="$jobs_root/$job_id/failed-output.json"
  destination="/home/sysadmin/$job_id-failed-output.json"
  [[ -f "$failure" && ! -L "$failure" ]] || stop "Failure output is missing for $job_id."
  [[ ! -e "$destination" && ! -L "$destination" ]] || stop "Export destination already exists: $destination"
  install -o sysadmin -g sysadmin -m 0600 "$failure" "$destination"
  echo "PASS: Failure output exported to $destination."
}

command_recover_translation() {
  local expected="$1"
  local job_id="$2"
  local job_dir
  require_repository_commit "$expected"
  validate_job_id "$job_id"
  [[ "$job_id" =~ ^translation-[0-9a-f]{32}-r[1-9][0-9]*-[0-9a-f]{8}$ ]] || stop "Expected a translation job ID."
  job_dir="$jobs_root/$job_id"
  [[ -f "$job_dir/request.json" && -f "$job_dir/failed-output.json" ]] || stop "Recoverable translation artifacts are missing."
  [[ "$(systemctl show "$(job_unit "$job_id")" --property=ActiveState --value)" == "failed" ]] || stop "Translation service is not failed."
  if [[ ! -e "$job_dir/result.json" ]]; then
    run_as_service env PYTHONDONTWRITEBYTECODE=1 python3 \
      "$repository/scripts/translation/recover_translation_failure.py" \
      --request "$job_dir/request.json" \
      --failure "$job_dir/failed-output.json" \
      --glossary "$repository/config/translation/glossary.json" \
      --output "$job_dir/result.json"
  fi
  [[ -f "$job_dir/result.json" && ! -L "$job_dir/result.json" ]] || stop "Recovered result was not created."
  run_as_service env PYTHONDONTWRITEBYTECODE=1 python3 - \
    "$job_dir/request.json" "$publisher_data/states" "$job_id" <<'PY'
import json
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

request = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
state_path = Path(sys.argv[2]) / f"{request['articleId']}.json"
state = json.loads(state_path.read_text(encoding="utf-8"))
if state.get("jobId") != sys.argv[3] or state.get("status") != "failed":
    raise SystemExit("publisher translation state is not the matching failed job")
state["status"] = "running"
state.pop("error", None)
state["updatedAt"] = datetime.now(timezone.utc).isoformat()
descriptor, temporary = tempfile.mkstemp(prefix=f".{state_path.name}.", dir=state_path.parent)
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        json.dump(state, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, state_path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
  echo "PASS: Completed translation recovered from $job_id."
}

