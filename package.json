{
  "name": "fanaticosos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run validate:content && npm run validate:settings && astro check && astro build && npm run validate:build",
    "validate:content": "node scripts/validate-content.mjs",
    "test:content-validation": "node scripts/test-content-validation.mjs",
    "test:article-routes": "node scripts/test-article-routes.mjs",
    "test:article-discovery": "node scripts/test-article-discovery.mjs",
    "validate:settings": "node scripts/validate-site-settings.mjs",
    "test:site-settings": "node scripts/test-site-settings.mjs",
    "test:build-media-policy": "node scripts/test-build-media-policy.mjs",
    "test:publisher": "node --test publisher/test/*.test.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.1.4",
    "js-yaml": "4.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3"
  }
}
