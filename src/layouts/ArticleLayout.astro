---
import { getCollection } from "astro:content";
import type { Article } from "../lib/articles";
import { articlePath, categoryPath, indexPath, relatedArticlesFor } from "../lib/articles";
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import ShareControls from "../components/ShareControls.astro";
import "../styles/article.css";

interface Props {
  article: Article;
  alternate: Article;
}

const { article, alternate } = Astro.props;
const locale = article.data.locale;
const canonicalPath = articlePath(article);
const alternatePath = articlePath(alternate);
const spanishPath = locale === "es" ? canonicalPath : alternatePath;
const englishPath = locale === "en" ? canonicalPath : alternatePath;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const relatedArticles = relatedArticlesFor(article, await getCollection("articles"));
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle", inLanguage: locale, headline: article.data.title, description: article.data.description,
      datePublished: article.data.publishedAt.toISOString(),
      ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
      mainEntityOfPage: canonicalUrl,
      author: { "@type": "Person", name: article.data.author },
      publisher: { "@type": "Organization", name: "FanaticOSOS", logo: { "@type": "ImageObject", url: new URL("/logo.png", Astro.site).href } },
      ...(article.data.featuredImage ? { image: [new URL(article.data.featuredImage.src, Astro.site).href] } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: locale === "es" ? "Inicio" : "Home", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: "Blog", item: new URL(indexPath(locale), Astro.site).href },
        { "@type": "ListItem", position: 3, name: article.data.title, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${article.data.title} — FanaticOSOS`}
  lang={locale}
  description={article.data.description}
  canonicalPath={canonicalPath}
  image={article.data.featuredImage?.src}
  bodyClass="article-page"
  alternatePaths={{ es: spanishPath, en: englishPath, "x-default": spanishPath }}
  structuredData={structuredData}
  contentType="article"
>
  <header class="article-header">
    <a class="brand-link" href={indexPath(locale)} aria-label={locale === "es" ? "Volver al blog" : "Back to the blog"}>
      <img src="/logo.png" alt="FanaticOSOS" />
    </a>
    <div class="language-control">
      <span>{locale === "es" ? "Idioma" : "Language"}</span>
      <a class="language-switch" href={alternatePath} lang={alternate.data.locale} hreflang={alternate.data.locale}>
        {locale === "es" ? "English version →" : "← Versión en español"}
      </a>
    </div>
  </header>

  <main class="article-shell article-detail-shell">
    <article class="article-content">
      <p class="article-category"><a href={categoryPath(locale, article.data.category)}>{article.data.category}</a></p>
      <h1>{article.data.title}</h1>
      <p class="article-description">{article.data.description}</p>
      <p class="article-byline">
        {locale === "es" ? "Por" : "By"} {article.data.author}
      </p>
      <ShareControls locale={locale} title={article.data.title} url={canonicalUrl} />
      {
        article.data.audio && (
          <div class="article-audio">
            <strong>{locale === "es" ? "Escuchar artículo" : "Listen to article"}</strong>
            <audio controls preload="metadata" src={article.data.audio.path}>
              {locale === "es" ? "Tu navegador no puede reproducir este audio." : "Your browser cannot play this audio."}
            </audio>
          </div>
        )
      }
      {
        article.data.featuredImage && (
          <figure>
            <img src={article.data.featuredImage.src} alt={article.data.featuredImage.alt} />
            {article.data.featuredImage.credit && <figcaption>{article.data.featuredImage.credit}</figcaption>}
          </figure>
        )
      }
      <div class="article-body"><slot /></div>
    </article>
    {
      relatedArticles.length > 0 && (
        <aside class="related-articles" aria-labelledby="related-title">
          <p class="related-eyebrow">{locale === "es" ? "Sigue leyendo" : "Keep reading"}</p>
          <h2 id="related-title">{locale === "es" ? "Más artículos" : "More stories"}</h2>
          <div class="related-list">
            {relatedArticles.map((related) => (
              <a class="related-card" href={articlePath(related)}>
                {related.data.featuredImage && <img src={related.data.featuredImage.src} alt={related.data.featuredImage.alt} loading="lazy" />}
                <span>{related.data.category}</span>
                <strong>{related.data.title}</strong>
                <small>{related.data.description}</small>
              </a>
            ))}
          </div>
          <a class="all-stories" href={indexPath(locale)}>{locale === "es" ? "Ver todos los artículos →" : "View all stories →"}</a>
        </aside>
      )
    }
  </main>

  <section class="article-community" aria-labelledby="community-title">
    <h2 id="community-title">{locale === "es" ? "¡Gracias por acompañarnos!" : "Thank you for joining us!"}</h2>
    <p>{locale === "es" ? "Sigue a Fanaticosos" : "Follow Fanaticosos"}</p>
    <SocialLinks />
  </section>

  <SiteFooter locale={locale} />
</BaseLayout>
