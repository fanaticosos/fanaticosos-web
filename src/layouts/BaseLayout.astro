---
import "../styles/global.css";

interface Props {
  title: string;
  lang?: "es" | "en";
  description?: string;
  ogDescription?: string;
  canonicalPath?: string;
  image?: string;
  bodyClass?: string;
  alternatePaths?: Partial<Record<"es" | "en" | "x-default", string>>;
  structuredData?: Record<string, unknown>;
  feedPath?: string;
  contentType?: "website" | "article";
}

const {
  title,
  lang = "es",
  description,
  ogDescription = description,
  canonicalPath = "/",
  image = "/logo.png",
  bodyClass,
  alternatePaths = {},
  structuredData,
  feedPath = lang === "es" ? "/rss.xml" : "/en/rss.xml",
  contentType = "website",
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site);
const imageUrl = new URL(image, Astro.site);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="FanaticOSOS" />
    <meta property="og:type" content={contentType} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {ogDescription && <meta name="twitter:description" content={ogDescription} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="FanaticOSOS" href={new URL(feedPath, Astro.site)} />
    {
      Object.entries(alternatePaths).map(([hreflang, alternatePath]) => (
        <link rel="alternate" hreflang={hreflang} href={new URL(alternatePath, Astro.site)} />
      ))
    }
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
