---
import type { Article, ArticleLocale } from "../lib/articles";
import { articlePath, categoryPath } from "../lib/articles";
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/article.css";

interface Props {
  locale: ArticleLocale;
  category: string;
  alternateCategory: string;
  articles: Article[];
}

const { locale, category, alternateCategory, articles } = Astro.props;
const canonicalPath = categoryPath(locale, category);
const alternateLocale = locale === "es" ? "en" : "es";
const alternatePath = categoryPath(alternateLocale, alternateCategory);
const spanishPath = locale === "es" ? canonicalPath : alternatePath;
const englishPath = locale === "en" ? canonicalPath : alternatePath;
---

<BaseLayout
  title={`${category} — FanaticOSOS`}
  lang={locale}
  description={locale === "es" ? `Artículos de ${category} en FanaticOSOS.` : `${category} articles from FanaticOSOS.`}
  canonicalPath={canonicalPath}
  bodyClass="article-page"
  alternatePaths={{ es: spanishPath, en: englishPath, "x-default": spanishPath }}
>
  <SiteNavigation locale={locale} alternatePath={alternatePath} />
  <main class="article-shell blog-index">
    <p class="article-category">{locale === "es" ? "Categoría" : "Category"}</p>
    <h1>{category}</h1>
    <div class="article-list">
      {
        articles.map((article) => (
          <article>
            <h2><a href={articlePath(article)}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
          </article>
        ))
      }
    </div>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
