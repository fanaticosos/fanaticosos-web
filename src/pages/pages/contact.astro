---
import InfoPageNavigation from "../../components/InfoPageNavigation.astro";
import ContactDetails from "../../components/ContactDetails.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/info-page.css";
---

<BaseLayout
  title="Contacto — FanaticOSOS"
  description="Contacta con FanaticOSOS por email, YouTube, X o Discord."
  canonicalPath="/pages/contact"
  bodyClass="info-page contact-page"
  alternatePaths={{ es: "/pages/contact", en: "/en/pages/contact", "x-default": "/pages/contact" }}
>
  <InfoPageNavigation alternatePath="/en/pages/contact" />
  <div class="page-wrap">
    <p class="page-eyebrow">Fanaticosos</p>
    <h1 class="page-title">Contacto</h1>
    <ContactDetails />
  </div>
  <SiteFooter />
</BaseLayout>
