---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogArticleCard from "../../components/BlogArticleCard.astro";
import SiteNavigation from "../../components/SiteNavigation.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { isBuildEligible } from "../../lib/articles";
import "../../styles/article.css";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "es" && isBuildEligible(article))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Blog — FanaticOSOS"
  description="Artículos y análisis deportivos de FanaticOSOS en español."
  canonicalPath="/blog/"
  bodyClass="article-page"
  alternatePaths={{ es: "/blog/", en: "/en/blog/", "x-default": "/blog/" }}
>
  <SiteNavigation alternatePath="/en/blog/" />
  <main class="article-shell blog-index">
    <h1>Blog</h1>
    <p class="article-description">Análisis deportivo desde la perspectiva de FanaticOSOS.</p>
    {
      articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article, index) => (
            <BlogArticleCard article={article} locale="es" featured={index === 0} />
          ))}
        </div>
      ) : (
        <p class="empty-state">Los primeros artículos están en preparación.</p>
      )
    }
  </main>
  <SiteFooter />
</BaseLayout>
