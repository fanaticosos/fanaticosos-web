---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import MusicCard from "../components/MusicCard.astro";
import PodcastEmbed from "../components/PodcastEmbed.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { siteSettings } from "../lib/siteSettings";
import "../styles/home.css";

const title = "FanaticOSOS — BearDown Chicago Bears";
const description = "La comunidad en español de los Chicago Bears. Podcast, música, blog y más. #DaBears #BearDown";
---

<BaseLayout title={title} description={description} ogDescription="La comunidad en español de los Chicago Bears.">
  <section class="hero">
    <div class="logo-wrap">
      <img src="/logo.png" alt="FanaticOSOS — BearDown Chicago Bears" />
    </div>
    <p class="hero-tagline">La Comunidad en Español de</p>
    <h1 class="hero-headline">Chicago Bears</h1>
    <p class="hero-sub">Podcast, análisis, música y más — todo para los fanáticos que viven y mueren con los Monstruos del Midway.</p>
  </section>

  <div class="slash-divider"></div>
  <SocialLinks />

  <section class="content-section">
    <p class="section-label">Contenido</p>
    <PodcastEmbed />

    <div class="cards-grid">
      <MusicCard playlistUrl={siteSettings.music.playlistUrl} weeklySongUrl={siteSettings.music.weeklySongUrl} />
      <ContentCard
        href="https://fanaticosos.substack.com"
        eyebrow="Leer"
        title="Blog"
        description="Artículos, análisis profundos y la perspectiva en español que no encontrarás en otro lugar."
        cta="Leer en Substack"
        iconPath="M19 22H5a3 3 0 0 1-3-3V3a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v12h4v4a3 3 0 0 1-3 3zm-1-5v2a1 1 0 0 0 2 0v-2h-2zm-2 3V4H4v15a1 1 0 0 0 1 1h11zM6 7h8v2H6V7zm0 4h8v2H6v-2zm0 4h5v2H6v-2z"
      />
    </div>
  </section>

  <div class="hashtag-strip">
    <p>#DaBears &nbsp;·&nbsp; #BearDown &nbsp;·&nbsp; #ChicagoBears &nbsp;·&nbsp; #Fanaticosos</p>
  </div>

  <SiteFooter />
</BaseLayout>
