---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LatestArticleCard from "../components/LatestArticleCard.astro";
import MusicCard from "../components/MusicCard.astro";
import PodcastEmbed from "../components/PodcastEmbed.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { siteSettings } from "../lib/siteSettings";
import { latestArticleForLocale } from "../lib/articles";
import "../styles/home.css";

const title = "FanaticOSOS — BearDown Chicago Bears";
const description = "La comunidad en español de los Chicago Bears. Podcast, música, blog y más. #DaBears #BearDown";
const latestArticle = latestArticleForLocale(await getCollection("articles"), "es");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: "FanaticOSOS", alternateName: "Fanaticos de los Osos", url: "https://fanaticosos.com/", inLanguage: ["es", "en"] },
    { "@type": "Organization", name: "FanaticOSOS", url: "https://fanaticosos.com/", logo: "https://fanaticosos.com/logo.png", sameAs: ["https://www.youtube.com/@fanaticosos", "https://x.com/fanaticososcom", "https://www.facebook.com/fanaticosos"] },
  ],
};
---

<BaseLayout title={title} description={description} ogDescription="La comunidad en español de los Chicago Bears." structuredData={structuredData}>
  <section class="hero">
    <div class="logo-wrap">
      <img src="/logo.png" alt="FanaticOSOS — BearDown Chicago Bears" />
    </div>
    <p class="hero-tagline">La Comunidad en Español de</p>
    <h1 class="hero-headline">Chicago Bears</h1>
    <p class="hero-sub">Podcast, análisis, música y más — todo para los fanáticos que viven y mueren con los Monstruos del Midway.</p>
  </section>

  <div class="slash-divider"></div>
  <SocialLinks />

  <section class="content-section">
    <p class="section-label">Contenido</p>
    <PodcastEmbed />

    <div class="cards-grid">
      <MusicCard playlistUrl={siteSettings.music.playlistUrl} weeklySongUrl={siteSettings.music.weeklySongUrl} />
      <LatestArticleCard article={latestArticle} />
    </div>
  </section>

  <div class="hashtag-strip">
    <p>#DaBears &nbsp;·&nbsp; #BearDown &nbsp;·&nbsp; #ChicagoBears &nbsp;·&nbsp; #Fanaticosos</p>
  </div>

  <SiteFooter />
</BaseLayout>
