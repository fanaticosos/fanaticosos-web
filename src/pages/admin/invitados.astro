---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin-invitados.css";
---

<BaseLayout
  title="Invitados — Administración FanaticOSOS"
  description="Panel privado de solicitudes de invitados de FanaticOSOS."
  canonicalPath="/admin/invitados"
  bodyClass="admin-invitados-page"
>
  <main class="admin-wrap">
    <header class="admin-header">
      <div><p>Administración</p><h1>Invitados</h1></div>
      <nav aria-label="Navegación administrativa">
        <a href="/participa">Ver Participa</a>
        <a href="/">Inicio</a>
      </nav>
    </header>
    <div class="admin-notice" data-admin-status role="status">Cargando solicitudes…</div>
    <section class="quick-reservation" aria-labelledby="reservation-heading">
      <div class="section-heading">
        <p>Reserva rápida</p>
        <h2 id="reservation-heading">Separar una fecha</h2>
        <span>Confirma directamente a un invitado sin llenar el formulario público.</span>
      </div>
      <form data-reservation-form>
        <label>Fecha disponible<select name="slotId" required data-available-slots><option value="">Cargando fechas…</option></select></label>
        <label>Nombre<input type="text" name="fullName" minlength="2" maxlength="100" autocomplete="name" required /></label>
        <label>Email<input type="email" name="email" maxlength="254" autocomplete="email" required /></label>
        <button type="submit">Separar y confirmar fecha</button>
      </form>
    </section>
    <section class="schedule-overview" aria-labelledby="schedule-heading">
      <div class="section-heading"><p>Calendario</p><h2 id="schedule-heading">Fechas e invitados</h2></div>
      <div class="schedule-list" data-schedule-list></div>
    </section>
    <div class="admin-filters" aria-label="Filtrar solicitudes">
      <button class="active" type="button" data-filter="all">Todas</button>
      <button type="button" data-filter="active">Pendientes</button>
      <button type="button" data-filter="confirmed">Confirmadas</button>
    </div>
    <section class="request-list" data-request-list aria-label="Solicitudes de invitados"></section>
  </main>
</BaseLayout>

<script>
  type GuestRequest = {
    id: string; slotId: string; status: string; fullName: string; email: string; phone: string;
    birthDate: string; bearsStory: string; songTitle: string; songArtist: string; songReason: string;
    emailStatus: string; decisionEmailStatus: string | null; submittedAt: string; streamDate: string;
    previousGame: string; nextGame: string; specialTopic: string | null; administrative: number;
  };
  type GuestSlot = {
    id: string; streamDate: string; status: string; previousGame: string; nextGame: string;
    requestCount: number; requestNames: string | null;
  };
  const list = document.querySelector<HTMLElement>("[data-request-list]");
  const scheduleList = document.querySelector<HTMLElement>("[data-schedule-list]");
  const reservationForm = document.querySelector<HTMLFormElement>("[data-reservation-form]");
  const slotSelect = document.querySelector<HTMLSelectElement>("[data-available-slots]");
  const status = document.querySelector<HTMLElement>("[data-admin-status]");
  let requests: GuestRequest[] = [];
  let slots: GuestSlot[] = [];
  let filter = "all";
  const labels: Record<string, string> = { pending: "Pendiente", waitlisted: "Espera", confirmed: "Confirmada", rejected: "Rechazada", canceled: "Cancelada" };
  const formatDate = (value: string) => new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
  const formatStreamDate = (value: string) => new Intl.DateTimeFormat("es-MX", { weekday: "short", day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${value}T12:00:00Z`));

  function element(tag: string, className?: string, content?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (content) node.textContent = content;
    return node;
  }

  function render() {
    if (!list) return;
    list.replaceChildren();
    const visible = requests.filter((item) => filter === "all" || filter === "confirmed" ? item.status === filter || filter === "all" : ["pending", "waitlisted"].includes(item.status));
    if (!visible.length) {
      list.append(element("p", "admin-empty", "No hay solicitudes en esta vista."));
      return;
    }
    for (const item of visible) {
      const article = element("article", "request-card");
      article.dataset.requestId = item.id;
      const heading = element("header", "request-heading");
      const title = element("div");
      title.append(element("span", `request-status status-${item.status}`, labels[item.status] ?? item.status), element("h2", "", item.fullName));
      heading.append(title, element("time", "", formatDate(item.submittedAt)));
      const schedule = element("div", "request-schedule");
      schedule.append(element("strong", "", `${item.streamDate} · 8:00 p.m. CDMX`), element("span", "", `Revisión: ${item.previousGame}`), element("span", "", `Próximo: ${item.nextGame}`));
      if (item.specialTopic) schedule.append(element("span", "", `Tema: ${item.specialTopic}`));
      const contact = element("p", "request-contact", `${item.email} · ${item.phone} · Nacimiento: ${item.birthDate}`);
      if (item.administrative) {
        contact.textContent = item.email;
        article.append(heading, schedule, contact, element("p", "administrative-note", "Reserva creada directamente desde administración."));
      } else {
        const storyBody = element("div", "request-story");
        storyBody.append(element("h3", "", "Cómo se hizo fan"), element("p", "", item.bearsStory), element("h3", "", "Canción"), element("p", "", `${item.songTitle} — ${item.songArtist}`), element("p", "", item.songReason));
        article.append(heading, schedule, contact, storyBody);
      }
      if (["pending", "waitlisted"].includes(item.status)) {
        const actions = element("div", "request-actions");
        for (const [action, copy] of [["confirm", "Confirmar fecha"], ["reject", "Rechazar"]]) {
          const button = element("button", `action-${action}`, copy);
          button.setAttribute("type", "button");
          button.dataset.action = action;
          actions.append(button);
        }
        article.append(actions);
      }
      const email = element("small", `email-state email-${item.emailStatus}`, `Correo inicial: ${item.emailStatus}`);
      if (item.decisionEmailStatus) email.textContent += ` · Decisión: ${item.decisionEmailStatus}`;
      article.append(email);
      list.append(article);
    }
  }

  function renderSchedule() {
    if (!scheduleList) return;
    scheduleList.replaceChildren();
    for (const slot of slots) {
      const row = element("article", "schedule-row");
      const date = element("div", "schedule-date");
      date.append(element("strong", "", formatStreamDate(slot.streamDate)), element("span", "", "8:00 p.m. CDMX"));
      const guests = element("div", "schedule-guests");
      const names = slot.requestNames?.split("|||").filter(Boolean) ?? [];
      guests.append(
        element("strong", "", names.length ? names.join(", ") : "Sin solicitudes"),
        element("span", "", `${slot.previousGame} → ${slot.nextGame}`),
      );
      row.append(date, guests, element("span", `schedule-count ${names.length ? "has-requests" : ""}`, `${slot.requestCount} solicitud${slot.requestCount === 1 ? "" : "es"}`));
      scheduleList.append(row);
    }
  }

  function renderAvailableSlots() {
    if (!slotSelect) return;
    slotSelect.replaceChildren();
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Selecciona una fecha";
    slotSelect.append(placeholder);
    const today = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Mexico_City", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
    const available = slots.filter((slot) => slot.status === "available" && slot.streamDate >= today);
    for (const slot of available) {
      const option = document.createElement("option");
      option.value = slot.id;
      option.textContent = `${formatStreamDate(slot.streamDate)} · ${slot.previousGame}`;
      slotSelect.append(option);
    }
    slotSelect.disabled = available.length === 0;
    if (!available.length) placeholder.textContent = "No hay fechas disponibles";
  }

  async function load() {
    try {
      const response = await fetch("/api/admin/invitados", { headers: { accept: "application/json" } });
      if (!response.ok) throw new Error(response.status === 401 ? "Acceso administrativo no autorizado." : "No se pudieron cargar las solicitudes.");
      ({ requests, slots } = await response.json());
      if (status) status.textContent = `${requests.length} solicitud${requests.length === 1 ? "" : "es"}.`;
      renderAvailableSlots();
      renderSchedule();
      render();
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : "No se pudieron cargar las solicitudes.";
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => button.addEventListener("click", () => {
    filter = button.dataset.filter ?? "active";
    document.querySelectorAll("[data-filter]").forEach((item) => item.classList.toggle("active", item === button));
    render();
  }));
  reservationForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!reservationForm.reportValidity()) return;
    const button = reservationForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = "Separando fecha…";
    const data = new FormData(reservationForm);
    try {
      const response = await fetch("/api/admin/invitados/reserve", {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? "request_failed");
      reservationForm.reset();
      if (status) status.textContent = result.emailStatus === "sent"
        ? "Fecha separada, invitado confirmado y correo enviado."
        : "Fecha separada e invitado confirmado; el correo no pudo enviarse.";
      await load();
    } catch (error) {
      const code = error instanceof Error ? error.message : "request_failed";
      const messages: Record<string, string> = {
        slot_unavailable: "La fecha ya no está disponible. Actualizamos la lista.",
        slot_past: "La fecha seleccionada ya pasó.",
        "invalid:fullName": "Revisa el nombre.",
        "invalid:email": "Revisa el email.",
      };
      if (status) status.textContent = messages[code] ?? "No se pudo separar la fecha.";
      await load();
    } finally {
      if (button) button.disabled = false;
    }
  });
  list?.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-action]");
    const card = button?.closest<HTMLElement>("[data-request-id]");
    if (!button || !card) return;
    button.disabled = true;
    if (status) status.textContent = "Guardando decisión…";
    try {
      const response = await fetch("/api/admin/invitados/action", {
        method: "POST", headers: { "content-type": "application/json", accept: "application/json" },
        body: JSON.stringify({ requestId: card.dataset.requestId, action: button.dataset.action }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? "request_failed");
      if (status) status.textContent = result.emailStatus === "sent" ? "Decisión guardada y correo enviado." : "Decisión guardada; el correo requiere reenvío.";
      await load();
    } catch {
      if (status) status.textContent = "No se pudo guardar la decisión.";
      button.disabled = false;
    }
  });
  load();
</script>
