---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogArticleCard from "../../../components/BlogArticleCard.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { isBuildEligible } from "../../../lib/articles";
import "../../../styles/article.css";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.locale === "en" && isBuildEligible(article))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Blog — FanaticOSOS"
  lang="en"
  description="FanaticOSOS sports journalism and analysis in English."
  canonicalPath="/en/blog/"
  bodyClass="article-page"
  alternatePaths={{ es: "/blog/", en: "/en/blog/", "x-default": "/blog/" }}
>
  <header class="article-header">
    <div class="brand-navigation">
      <a class="brand-link" href="/" aria-label="FanaticOSOS home"><img src="/logo.png" alt="FanaticOSOS" /></a>
      <a class="home-link" href="/">Home</a>
    </div>
    <a class="language-switch" href="/blog/" lang="es" hreflang="es">Leer en español</a>
  </header>
  <main class="article-shell blog-index">
    <h1>Blog</h1>
    <p class="article-description">Sports journalism and analysis from the FanaticOSOS perspective.</p>
    {
      articles.length > 0 ? (
        <div class="article-list">
          {articles.map((article, index) => (
            <BlogArticleCard article={article} locale="en" featured={index === 0} />
          ))}
        </div>
      ) : (
        <p class="empty-state">The first articles are being prepared.</p>
      )
    }
  </main>
  <SiteFooter locale="en" />
</BaseLayout>
