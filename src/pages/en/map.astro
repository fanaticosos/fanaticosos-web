---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FanMap from "../../components/FanMap.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/fan-map.css";
---
<BaseLayout title="Chicago Bears fan map — FanaticOSOS" lang="en" description="See where Chicago Bears fans live and add your city to the Bear Nation map." canonicalPath="/en/map/" bodyClass="map-page" alternatePaths={{ es: "/mapa/", en: "/en/map/", "x-default": "/mapa/" }}>
  <link slot="head" rel="preconnect" href="https://tile.openstreetmap.org" crossorigin="anonymous" />
  <link slot="head" rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
  <script is:inline slot="head" src="/vendor/leaflet/leaflet.min.js"></script>
  <FanMap locale="en" /><SiteFooter locale="en" />
</BaseLayout>
