---
interface Props { locale?: "es" | "en"; }
const { locale = "es" } = Astro.props;
---
<a class="back-link" href="/">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.78 19.03a.75.75 0 0 1-1.06 0l-6.25-6.25a.75.75 0 0 1 0-1.06l6.25-6.25a.75.75 0 1 1 1.06 1.06L5.81 11.5h14.44a.75.75 0 0 1 0 1.5H5.81l4.97 4.97a.75.75 0 0 1 0 1.06z"></path></svg>
  {locale === "es" ? "Volver al inicio" : "Back to home"}
</a>

<style>
  .back-link {
    align-items: center;
    color: var(--gray);
    display: inline-flex;
    font-size: 13px;
    font-weight: 500;
    gap: 6px;
    text-decoration: none;
    transition: color .2s;
  }
  .back-link:hover { color: var(--orange); }
  .back-link svg { fill: currentColor; height: 14px; width: 14px; }
  @media (prefers-reduced-motion: reduce) { .back-link { transition: none; } }
</style>
