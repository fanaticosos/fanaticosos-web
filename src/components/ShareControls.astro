---
interface Props {
  locale: "es" | "en";
  title: string;
  url: string;
}

const { locale, title, url } = Astro.props;
const shareLabel = locale === "es" ? "Compartir" : "Share";
const copyLabel = locale === "es" ? "Copiar enlace" : "Copy link";
const copiedLabel = locale === "es" ? "Enlace copiado" : "Link copied";
const failedLabel = locale === "es" ? "No se pudo copiar el enlace" : "The link could not be copied";
---

<div class="share-controls" data-share-controls data-title={title} data-url={url} data-copied-label={copiedLabel} data-failed-label={failedLabel}>
  <button class="share-primary" type="button" data-share-button>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2.39 1.19L8.91 13.7a3.1 3.1 0 0 0 0-3.4l6.7-3.49A3 3 0 1 0 15 5c0 .23.03.46.08.67l-6.7 3.49a3 3 0 1 0 0 5.68l6.7 3.49A3 3 0 1 0 18 16Z"></path></svg>
    <span>{shareLabel}</span>
  </button>
  <button class="share-copy" type="button" data-copy-button>{copyLabel}</button>
  <span class="share-feedback" data-share-feedback aria-live="polite"></span>
</div>

<script>
  for (const element of document.querySelectorAll("[data-share-controls]")) {
    if (!(element instanceof HTMLElement)) continue;
    const controls = element;
    const shareButton = controls.querySelector("[data-share-button]");
    const copyButton = controls.querySelector("[data-copy-button]");
    const feedback = controls.querySelector("[data-share-feedback]");
    if (!(shareButton instanceof HTMLButtonElement) || !(copyButton instanceof HTMLButtonElement) || !(feedback instanceof HTMLElement)) continue;
    const shareData = { title: controls.dataset.title ?? document.title, url: controls.dataset.url ?? window.location.href };
    const copy = async () => {
      try {
        await navigator.clipboard.writeText(shareData.url);
        feedback.textContent = controls.dataset.copiedLabel ?? "Link copied";
      } catch {
        feedback.textContent = controls.dataset.failedLabel ?? "The link could not be copied";
      }
    };
    shareButton.addEventListener("click", async () => {
      if (navigator.share) {
        try { await navigator.share(shareData); } catch (error) { if (!(error instanceof DOMException) || error.name !== "AbortError") await copy(); }
      } else await copy();
    });
    copyButton.addEventListener("click", copy);
  }
</script>
